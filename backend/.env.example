# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# When running backend locally: port is 5439
# When running backend in Docker: change localhost:5439 to postgres:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/dataforge_db

# Authentication & Security Secrets
JWT_SECRET=super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600s
JWT_REFRESH_SECRET=another-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=604800s
ADMIN_SEED_PASSWORD=admin1234

# CORS Settings (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Marketplace Platform Settings
COMMISSION_PERCENT=10
