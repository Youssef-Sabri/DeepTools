# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# When running backend locally: port is 5439
# When running backend in Docker: change localhost:5439 to postgres:5432
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5439/dataforge_db

# Authentication & Security Secrets
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
TRUST_PROXY_HOPS=0
# HTTPS service accepting POST {to,subject,text} with Bearer authorization.
# Password resets return 503 until all three values are configured.
# PASSWORD_RESET_DELIVERY_URL=https://mail-service.example.com/send
# PASSWORD_RESET_DELIVERY_KEY=replace-with-private-key
# PASSWORD_RESET_URL=http://localhost:3000/en/auth/reset-password

# CORS Settings (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Marketplace Platform Settings
COMMISSION_PERCENT=10
PAYMENT_PROVIDER=unconfigured
PAYMENT_CURRENCY=USD
# Demo seed is destructive on neither existing data nor production; enable only on an empty local DB.
# ALLOW_DEMO_SEED=true
