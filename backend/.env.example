# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# The password here must match the live `postgres` role password. It is applied
# only when the pgdata volume is FIRST initialised; for an existing volume use:
#   docker exec -e NEWPW="<new>" deeptools-postgres psql -U postgres -d dataforge_db \
#     -c "ALTER USER postgres WITH PASSWORD '<new>';"
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5439/dataforge_db?schema=public

# Authentication & Security
# Must be a random 32+ character value. The app refuses to start with any known
# placeholder in ANY environment, so generate one rather than editing by hand:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SEED_PASSWORD=replace-with-admin-seed-password

# Error handling. Leave false/unset outside local development: when true,
# unexpected 500s echo the raw error message (Prisma internals, container paths)
# to the client. Startup fails if this is "true" while NODE_ENV=production.
EXPOSE_ERROR_DETAILS=false

# CORS & Integration
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
FRONTEND_URL=http://localhost:3000

# File Storage & Business Logic
UPLOAD_DIR=./uploads
COMMISSION_PERCENT=10


