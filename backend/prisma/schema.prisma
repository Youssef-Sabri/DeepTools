generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= Enums ================= //
enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// ================= Models ================= //
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String
  passwordHash  String   @map("password_hash")
  role          Role     @default(USER)
  
  // حقل الحذف الوهمي (Soft Delete)
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  licenses            License[]
  orders              Order[]
  sellerProducts      Product[] @relation("SellerProducts")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // هنا يمكننا ترك Cascade لأن حذف المستخدم نهائياً يعني عدم حاجته لتوكنات الاستعادة
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  sellerId      String    @map("seller_id") @db.Uuid
  name          String
  nameAr        String?   @map("name_ar")
  description   String
  descriptionAr String?   @map("description_ar")
  category      String    @db.VarChar(50)
  price         Int
  version       String    @default("1.0.0") @db.VarChar(20)
  status        ProductStatus @default(PENDING) // تم التعديل لاستخدام Enum
  fileKey       String?   @map("file_key")
  fileSize      Int?      @map("file_size")
  fileMime      String?   @map("file_mime") @db.VarChar(100)
  fileChecksum  String?   @map("file_checksum")
  rejectionNote String?   @map("rejection_note")
  reviewedAt    DateTime? @map("reviewed_at")
  
  badge         String?   @db.VarChar(20)
  badgeAr       String?   @map("badge_ar") @db.VarChar(30)
  
  // حقل الحذف الوهمي (Soft Delete)
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // تم التعديل إلى Restrict لحماية المنتجات من الحذف العشوائي إذا تم حذف البائع
  seller   User      @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)
  licenses License[]
  orders   Order[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@map("products")
}

model Template {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  nameAr        String?  @map("name_ar")
  description   String
  descriptionAr String?  @map("description_ar")
  category      String   @db.VarChar(50)
  compatibility String[]
  price         Int
  version       String   @default("1.0.0") @db.VarChar(20)
  downloads     Int      @default(0)
  
  // تم استبدال downloadUrl بـ fileKey لدواعي أمنية
  fileKey       String?  @map("file_key") 
  
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("templates")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  planName  String    @map("plan_name") @db.VarChar(50)
  status    SubscriptionStatus @default(ACTIVE) // تم التعديل لاستخدام Enum
  startDate DateTime  @default(now()) @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // تم التعديل إلى Restrict لعدم ضياع السجلات المالية
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model License {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  licenseKey String    @unique @map("license_key")
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // تم التعديل إلى Restrict لحماية التراخيص المدفوعة
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([productId])
  @@map("licenses")
}

model Order {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  amount            Int
  commissionPercent Int      @default(10) @map("commission_percent")
  commissionAmount  Int      @default(0) @map("commission_amount")
  sellerAmount      Int      @default(0) @map("seller_amount")
  status            OrderStatus @default(COMPLETED) // تم التعديل لاستخدام Enum
  paymentGateway    String   @default("simulated") @map("payment_gateway") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  // SetNull هنا ممتاز، لو المنتج اتحذف الطلب هيفضل موجود كإيصال مالي بس بدون تفاصيل المنتج
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@map("orders")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}