generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= Enums ================= //
enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

// ================= Models ================= //
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String
  passwordHash  String   @map("password_hash")
  role          Role     @default(USER)
  tokenVersion  Int      @default(0) @map("token_version")
  
  // حقل الحذف الوهمي (Soft Delete)
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  licenses            License[]
  orders              Order[]
  sellerProducts      Product[] @relation("SellerProducts")
  passwordResetTokens PasswordResetToken[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // هنا يمكننا ترك Cascade لأن حذف المستخدم نهائياً يعني عدم حاجته لتوكنات الاستعادة
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  sellerId      String    @map("seller_id") @db.Uuid
  name          String
  nameAr        String?   @map("name_ar")
  description   String
  descriptionAr String?   @map("description_ar")
  category      String    @db.VarChar(50)
  price         Int
  version       String    @default("1.0.0") @db.VarChar(20)
  status        ProductStatus @default(PENDING) // تم التعديل لاستخدام Enum
  fileKey       String?   @map("file_key")
  fileSize      Int?      @map("file_size")
  fileMime      String?   @map("file_mime") @db.VarChar(100)
  fileChecksum  String?   @map("file_checksum")
  approvedFileKey String? @map("approved_file_key")
  approvedFileMime String? @map("approved_file_mime") @db.VarChar(100)
  rejectionNote String?   @map("rejection_note")
  reviewedAt    DateTime? @map("reviewed_at")
  
  badge         String?   @db.VarChar(20)
  badgeAr       String?   @map("badge_ar") @db.VarChar(30)
  
  // حقل الحذف الوهمي (Soft Delete)
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // تم التعديل إلى Restrict لحماية المنتجات من الحذف العشوائي إذا تم حذف البائع
  seller   User      @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)
  licenses License[]
  orders   Order[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([nameAr(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_ar_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@index([descriptionAr(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_ar_trgm_idx")
  @@map("products")
}

model License {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  licenseKey String    @unique @map("license_key")
  fileKey    String?   @map("file_key")
  fileMime   String?   @map("file_mime") @db.VarChar(100)
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // تم التعديل إلى Restrict لحماية التراخيص المدفوعة
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("licenses")
}

model Order {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  sellerId          String?  @map("seller_id") @db.Uuid
  productName       String?  @map("product_name")
  fileKey           String?  @map("file_key")
  fileMime          String?  @map("file_mime") @db.VarChar(100)
  pendingKey        String?  @unique @map("pending_key")
  currency          String   @default("USD") @db.VarChar(3)
  amount            Int
  commissionPercent Int      @default(10) @map("commission_percent")
  commissionAmount  Int      @default(0) @map("commission_amount")
  sellerAmount      Int      @default(0) @map("seller_amount")
  status            OrderStatus @default(PENDING)
  paymentGateway    String   @default("unconfigured") @map("payment_gateway") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  // SetNull هنا ممتاز، لو المنتج اتحذف الطلب هيفضل موجود كإيصال مالي بس بدون تفاصيل المنتج
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  paymentEvents PaymentEvent[]

  @@index([userId])
  @@index([productId])
  @@map("orders")
  @@index([sellerId, status])
}

model PaymentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  gateway   String   @db.VarChar(50)
  eventId   String   @map("event_id")
  orderId   String   @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([gateway, eventId])
  @@index([orderId])
  @@map("payment_events")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model RateLimitBucket {
  key     String   @id @db.VarChar(128)
  hits    Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
